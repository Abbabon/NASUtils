# Synology shared folder paths (defaults work without .env)
INPUT_DIRECTORY=/volume1/Assets/Photos/Photosync
OUTPUT_DIRECTORY=/volume1/Assets/Photos/Archive

# Where deleted files go until the trash is emptied. Must be outside OUTPUT_DIRECTORY and
# not part of the Backblaze backup task, or deleting a file uploads it again.
# Defaults are ./trash and ./config next to docker-compose.yml.
#TRASH_DIRECTORY=./trash
#CONFIG_DIRECTORY=./config

# Dashboard: http://<nas>:8310
DASHBOARD_PORT=8310
# Set to require a password (any username) in the browser. Strongly recommended:
# the dashboard can delete files.
DASHBOARD_PASSWORD=

# Network location of the archive for the dashboard's Finder/Explorer buttons. Normally
# derived from OUTPUT_DIRECTORY and the hostname you browse to; set it if that guess is wrong.
#ARCHIVE_SHARE=//your-nas/Assets/Photos/Archive

# Timezone (IANA format, e.g. America/New_York, Europe/London)
TZ=Your/Timezone
